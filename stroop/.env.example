# Public site origin. No path and no trailing slash.
# Production builds use https://wordlesolve.net when this is empty.
# A local http origin is allowed for a local production build and will not be indexed.
NEXT_PUBLIC_SITE_URL=https://wordlesolve.net

# Optional. Shown on the contact page only when it is a valid email address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. The content value from the Google Search Console HTML tag method.
GOOGLE_SITE_VERIFICATION=-3JY0T7WhKfL5SRSAc1jOhCRx9u5u420U6YMMSSXAFQ
